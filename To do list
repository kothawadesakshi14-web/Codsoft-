import tkinter as tk
from tkinter import messagebox

def add_task():
    task = entry.get()
    if task:
        listbox.insert(tk.END, task)
        entry.delete(0, tk.END)
    else:
        messagebox.showwarning("Warning", "Please enter a task")

def delete_task():
    selected = listbox.curselection()
    if selected:
        listbox.delete(selected[0])
    else:
        messagebox.showwarning("Warning", "Please select a task")

def update_task():
    selected = listbox.curselection()
    task = entry.get()

    if selected and task:
        listbox.delete(selected[0])
        listbox.insert(selected[0], task)
        entry.delete(0, tk.END)
    else:
        messagebox.showwarning("Warning", "Select a task and enter new text")

def complete_task():
    selected = listbox.curselection()

    if selected:
        task = listbox.get(selected[0])
        if not task.startswith("✓ "):
            listbox.delete(selected[0])
            listbox.insert(selected[0], "✓ " + task)
    else:
        messagebox.showwarning("Warning", "Please select a task")


# Create window
root = tk.Tk()
root.title("To-Do List Application")
root.geometry("400x450")

title = tk.Label(root, text="My To-Do List",
                 font=("Arial", 20, "bold"))
title.pack(pady=15)

entry = tk.Entry(root, width=35, font=("Arial", 12))
entry.pack(pady=10)

listbox = tk.Listbox(root, width=40, height=12,
                     font=("Arial", 12))
listbox.pack(pady=10)

tk.Button(root, text="Add Task",
          command=add_task, width=15).pack(pady=5)

tk.Button(root, text="Update Task",
          command=update_task, width=15).pack(pady=5)

tk.Button(root, text="Complete Task",
          command=complete_task, width=15).pack(pady=5)

tk.Button(root, text="Delete Task",
          command=delete_task, width=15).pack(pady=5)

root.mainloop()
